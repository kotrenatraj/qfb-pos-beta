# copy to /etc/qfb-pos.env  (chmod 600)
QFB_PASSWORD=change-me-to-a-long-password
PORT=3000
DATA_DIR=/var/lib/qfb-pos
# set to 1 only when behind Caddy/nginx (so the real client IP is used for login throttling)
TRUST_PROXY=0

# Optional FREE automatic alerts for bill changes (set one or both; see DEPLOY.md section 6)
# Telegram bot (most reliable):
# TG_TOKEN=123456:ABC...
# TG_CHAT=your-chat-id
# CallMeBot WhatsApp (free, unofficial):
# CMB_KEY=api-key-from-callmebot
# CMB_PHONE=919876543210     # the number that activated CallMeBot (defaults to the Alert number in Settings)
