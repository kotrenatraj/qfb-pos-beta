# copy to /etc/qfb-pos.env  (chmod 600)
QFB_PASSWORD=change-me-to-a-long-password
PORT=3000
DATA_DIR=/var/lib/qfb-pos
# set to 1 only when behind Caddy/nginx (so the real client IP is used for login throttling)
TRUST_PROXY=0

# Optional: send bill-change alerts to WhatsApp automatically (Meta WhatsApp Cloud API)
# WA_TOKEN=permanent-access-token
# WA_PHONE_ID=your-whatsapp-business-phone-number-id
# WA_TEMPLATE=bill_alert      # approved template with ONE body variable {{1}}; needed to message a number that has not written to you in the last 24 h
# WA_LANG=en
